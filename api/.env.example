# Copy this file to .env and fill in the values

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/car_service_platform
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/car_service_platform?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/car_service_platform

# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list, or * for any origin
CORS_ORIGIN=*

PORT=5000

# Default station working hours (stations can override in their own profile)
OPEN_HOUR=8
CLOSE_HOUR=18
SLOT_MINUTES=60
BOOKING_WINDOW_DAYS=30

# Email notifications (optional - app works without these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AutoCare <no-reply@autocare.example>

# SMS notifications (optional - any HTTP gateway works)
SMS_WEBHOOK_URL=
SMS_API_KEY=